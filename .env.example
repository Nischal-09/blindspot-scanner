# ── Required for AI Reports ─────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Elasticsearch (Optional) ───────────────────────────────
# Leave ES_PASS empty to run in memory-only mode
ES_HOST=https://localhost:9200
ES_USER=elastic
ES_PASS=

# ── Elasticsearch TLS ──────────────────────────────────────
ES_VERIFY_CERTS=false

# ── Server ─────────────────────────────────────────────────
MAPPER_PORT=5001

# ── Supabase Auth ──────────────────────────────────────────
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ── CORS ───────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5001,http://localhost:5173,http://127.0.0.1:5001,http://127.0.0.1:5173
